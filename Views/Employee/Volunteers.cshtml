@model IEnumerable<GiftOfTheGivers.Models.Volunteer>

@{
    ViewData["Title"] = "Volunteer Sign-ups";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <p class="text-success fw-bold text-uppercase">
                Employee Area
            </p>

            <h1 class="section-title">
                Volunteer Sign-ups
            </h1>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            ← Dashboard

        </a>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">

            No volunteer registrations have been submitted yet.

        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead>

                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Skills</th>
                        <th>Availability</th>
                        <th>Date Registered</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var volunteer in Model)
                    {
                        <tr>

                            <td>
                                @volunteer.FullName
                            </td>

                            <td>
                                @volunteer.Email
                            </td>

                            <td>
                                @volunteer.Skills
                            </td>

                            <td>
                                @volunteer.Availability
                            </td>

                            <td>
                                @volunteer.DateRegistered
                                .ToString("dd MMM yyyy")
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>