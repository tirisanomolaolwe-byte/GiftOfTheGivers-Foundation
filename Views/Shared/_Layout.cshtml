<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Gift of the Givers</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <!-- Nav -->

    <header>

        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">

            <div class="container">

                <!-- Logo / Brand -->

                <a class="navbar-brand d-flex align-items-center"
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/logo-gift-of-the-givers.jpg"
                         alt="Gift of the Givers"
                         class="app-logo" />

                    <div class="brand-text ms-2">
                        <strong>GIFT OF THE GIVERS</strong>
                        <span>Humanitarian Relief</span>
                    </div>

                </a>


                <!-- Mobile menu button -->

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation links -->

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                Home

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">

                                About

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="ReliefProjects"
                               asp-action="Index">

                                Relief Projects

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Donations"
                               asp-action="Create">

                                Donate

                            </a>

                        </li>


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Volunteers"
                               asp-action="Create">

                                Volunteer

                            </a>

                        </li>

                        @if (User?.Identity?.IsAuthenticated == true && User.IsInRole("Employee"))
                        {
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Employee"
                                   asp-action="Index">

                                    Employee Dashboard

                                </a>

                            </li>
                        }


                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Contact">

                                Contact

                            </a>

                        </li>


                        <!-- Identity -->

                        <li class="nav-item ms-lg-3">

                            <partial name="_LoginPartial" />

                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>



    <main>

        @RenderBody()

    </main>


    <!-- Footer -->

    <footer class="border-top footer">

        <div class="container py-4">

            <div class="row">

                <div class="col-md-6">

                    <strong>
                        Gift of the Givers Foundation
                    </strong>

                    <p class="text-muted mb-0">

                        Humanitarian assistance where it is needed most.

                    </p>

                </div>


                <div class="col-md-6 text-md-end">

                    <p class="text-muted mb-0">

                        &copy; @DateTime.Now.Year Gift of the Givers

                    </p>

                </div>

            </div>

        </div>

    </footer>


    <!-- Bootstrap -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>