@model GiftOfTheGivers.Models.Donation

@{
    ViewData["Title"] = "Donation Confirmation";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="feature-card text-center">

                <div class="feature-icon mx-auto mb-4">
                    ✓
                </div>

                <h1 class="section-title mb-3">
                    Thank You for Your Support
                </h1>

                <p class="text-muted mb-4">

                    Your symbolic donation has been recorded
                    successfully as part of this prototype.

                </p>


                <div class="text-start bg-light rounded p-4 mb-4">

                    <p>
                        <strong>Donation ID:</strong>
                        @Model.Id
                    </p>

                    <p>
                        <strong>Donor:</strong>
                        @Model.DonorName
                    </p>

                    <p>
                        <strong>Amount:</strong>
                        @Model.Currency @Model.Amount.ToString("N2")
                    </p>

                    <p>
                        <strong>Type:</strong>
                        @Model.DonationType
                    </p>

                    <p class="mb-0">
                        <strong>Date:</strong>
                        @Model.DonationDate.ToString("dd MMMM yyyy")
                    </p>

                    @if (TempData["TaxCertificateNumber"] != null)
                    {
                        <div class="alert alert-success mt-4">
                            <strong>Tax Certificate Generated</strong>
                            <br />
                            Certificate Number:
                            <strong>@TempData["TaxCertificateNumber"]</strong>
                            <br />
                            Generated Date:
                            @TempData["TaxCertificateDate"]
                        </div>
                    }
                    
                    @if (TempData["TaxCertificateError"] != null)
                    {
                        <div class="alert alert-warning mt-4">
                            @TempData["TaxCertificateError"]
                        </div>
                    }

                    @if (TempData["TaxCertificateError"] != null)
                    {
                        <div class="alert alert-danger mt-4">
                            <strong>Tax Certificate Generation Failed</strong>
                            <br />
                            @TempData["TaxCertificateError"]
                        </div>
                    }

                </div>


                <a asp-action="TaxCertificate"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">

                    View Tax Certificate

                </a>

            </div>

        </div>

    </div>

</div>