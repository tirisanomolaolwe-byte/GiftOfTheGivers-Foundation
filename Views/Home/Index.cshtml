@{
    ViewData["Title"] = "Home";
}


<!-- HERO -->

<section class="hero-section">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-7">

                <p class="text-success fw-bold text-uppercase mb-3">

                    Humanitarian Relief & Disaster Response

                </p>


                <h1 class="hero-title mb-4">

                    Help where it matters most.

                </h1>


                <p class="hero-text mb-4">

                    Gift of the Givers coordinates humanitarian
                    assistance, volunteers and resources to support
                    communities affected by disasters and emergencies.

                </p>


                <div class="d-flex flex-wrap gap-3">

                    <a asp-controller="Donations" asp-action="Create"
                       class="btn btn-primary btn-lg px-4">

                        Donate Now

                    </a>


                    <a asp-controller="Volunteers" asp-action="Index"
                       class="btn btn-outline-primary btn-lg px-4">

                        Become a Volunteer

                    </a>

                </div>

            </div>


            <!-- Hero information card -->

            <div class="col-lg-5 mt-5 mt-lg-0">

                <div class="feature-card">

                    <div class="feature-icon mb-4">

                        +

                    </div>


                    <h3>

                        Respond. Support. Rebuild.

                    </h3>


                    <p class="text-muted">

                        This prototype demonstrates a centralised
                        platform for managing relief projects,
                        donations and volunteer registrations.

                    </p>


                    <div class="mt-4">

                        <strong>

                            Current focus

                        </strong>


                        <p class="text-muted mb-0">

                            Disaster relief coordination for
                            communities in need.

                        </p>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- Features -->

<section class="py-5">

    <div class="container">

        <div class="text-center mb-5">

            <h2 class="section-title">

                How we make a difference

            </h2>


            <p class="section-subtitle">

                Technology supporting humanitarian action.

            </p>

        </div>


        <div class="row g-4">


            <!-- Relief -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon mb-4">

              

                    </div>


                    <h4>

                        Relief Projects

                    </h4>


                    <p class="text-muted">

                        Monitor ongoing relief initiatives and
                        coordinate humanitarian support for
                        communities affected by emergencies.

                    </p>

                </div>

            </div>


            <!-- Donations -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon mb-4">

                  

                    </div>


                    <h4>

                        Donations

                    </h4>


                    <p class="text-muted">

                        Support humanitarian operations through
                        one-time or recurring donations using
                        multiple currencies.

                    </p>

                </div>

            </div>


            <!-- Volunteers -->

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon mb-4">

                      

                    </div>


                    <h4>

                        Volunteers

                    </h4>


                    <p class="text-muted">

                        Register your skills and availability
                        to support humanitarian activities.

                    </p>

                </div>

            </div>

        </div>

    </div>

</section>