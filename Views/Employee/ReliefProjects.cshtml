@model IEnumerable<GiftOfTheGivers.Models.ReliefProject>

@{
    ViewData["Title"] = "Relief Projects";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <p class="text-success fw-bold text-uppercase">
                Employee Area
            </p>

            <h1 class="section-title">
                Relief Projects
            </h1>

        </div>

        <div>

            <a asp-action="Index"
               class="btn btn-outline-secondary me-2">

                ← Dashboard

            </a>

            <a asp-controller="ReliefProjects"
               asp-action="Create"
               class="btn btn-primary">

                + New Project

            </a>

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="alert alert-info">

            No relief projects have been created yet.

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var project in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="feature-card h-100">

                        <span class="badge bg-success mb-3">
                            @project.Status
                        </span>

                        <h3>
                            @project.Name
                        </h3>

                        <p class="text-muted">
                             @project.Location
                        </p>

                        <p>
                            @project.Description
                        </p>

                        <p class="small text-muted">

                            Started:
                            @project.DateStarted.ToString("dd MMM yyyy")

                            <br />

                            Updated:
                            @project.LastUpdated.ToString("dd MMM yyyy")

                        </p>

                        <a asp-controller="ReliefProjects"
                           asp-action="Details"
                           asp-route-id="@project.Id"
                           class="btn btn-outline-primary">

                            View Details

                        </a>

                    </div>

                </div>
            }

        </div>
    }

</div>